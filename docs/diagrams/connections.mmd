  VALVE["12V valve"]
  ACT["window actuator"]
  MAINS["external mains box trigger IN"]

  %% ---- 12V rail ----
  PSU_V --> B_IN
  PSU_V --> H_B
  PSU_V --> K_C1
  PSU_G --> B_ING
  PSU_G --> H_BG

  %% ---- 5V rail ----
  B_OUT --> P_VSYS
  B_OUTG --> PSU_G

  %% ---- 3V3 rail ----
  P_3V3 --> A_V
  P_3V3 --> L_V
  P_3V3 --> K_V
  P_3V3 --> H_VCC

  %% ---- GND (common) ----
  P_GND --- PSU_G
  P_GND --- A_G
  P_GND --- L_G
  P_GND --- K_G
  P_GND --- H_G
  P_GND --- BTN_G

  %% ---- I2C bus (3.3V) ----
  P_SDA --- A_SDA
  P_SDA --- L_SDA
  P_SCL --- A_SCL
  P_SCL --- L_SCL

  %% ---- relay logic ----
  P_R1 --> K_1
  P_R2 --> K_2

  %% ---- valve (12V switched by CH1) ----
  K_NO1 --> VALVE
  VALVE --> PSU_G

  %% ---- mains trigger (CH2 dry contact) ----
  K_C2 --> MAINS
  K_NO2 --> MAINS

  %% ---- H-bridge control ----
  P_RP --> H_RP
  P_LP --> H_LP
  P_EN --> H_EN
  H_IS --> P_IS
  H_MP --> ACT
  H_MG --> ACT

  %% ---- buttons (active-low to GND, internal pull-ups) ----
  P_BP --- BTN_P
  P_BM --- BTN_M
  P_BOK --- BTN_OK
