  subgraph HB["BTS7960 H-bridge (U3)"]
    H_B["B+ 12V"]
    H_BG["B-"]
    H_VCC["VCC 3V3 logic"]
    H_G["GND"]
    H_RP["RPWM"]
    H_LP["LPWM"]
    H_EN["R_EN + L_EN"]
    H_IS["R_IS + L_IS"]
    H_MP["M+"]
    H_MG["M-"]
  end

